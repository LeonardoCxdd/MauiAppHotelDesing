<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotelDesing.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource TertiaryLight}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand" 
                         Padding="10" >
        <Label
            Text="Calculo da mediaria!"
            FontSize="35"
            TextColor="White"
            FontFamily="SoraExtraLight"
            VerticalOptions="Center" 
            HorizontalOptions="Center"/>

        <Frame Padding="10">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto"
                  ColumnDefinitions="*, *, 2*" >

                    <Label Grid.Row="0" Grid.Column="0"
                      Text="Adultos:" />

                    <Label Grid.Row="0" Grid.Column="1"
                       TextColor="{StaticResource TertiaryLight}"
                       Text="{Binding Value}" 
                       BindingContext="{x:Reference stp_Adultos}" />


                    <Stepper Grid.Row="0"  Grid.Column="2"
                             x:Name="stp_Adultos" 
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />

                    <Label Grid.Row="1"  Grid.Column="0"
                           Text="Criancas:" />

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="{StaticResource TertiaryLight}"
                           Text="{Binding Value}" 
                           BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />
                   
                </Grid>


                <Label Text="Escolha Sua Suite"/>

                <Picker x:Name="pck_quarto"
                        Title="Selecione Sua Acomodação" />


                <Frame Padding="10"
                       Margin="10">
                    <VerticalStackLayout>
                        <Label Text="Periodo da estadia" />
                        <HorizontalStackLayout>
                            <Label Text="Check-in:" />
                            <DatePicker x:Name="ddpck_checkin"
                                        Format="dd/mm/yyyy" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <Label Text="CheckOut:" />
                            <DatePicker x:Name="ddpck_checkOut"
                                        Format="dd/mm/yyyy" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="Avancar"
                        Background="Azure"/>



                <Label 
                    FontFamily="SoraExtraLight"
                    FontSize="12"
                    TextColor="LightGray"
                    Text="Desenvolvido por:LeonardoCM no ano de 2026" />


            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>